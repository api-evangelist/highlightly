{
  "opencollection": "1.0.0",
  "info": {
    "name": "Highlightly Sports Catalog Standings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-rapidapi-key",
      "value": "{{x-rapidapi-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Standings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get football league standings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sports.highlightly.net/football/standings",
            "params": [
              {
                "name": "leagueId",
                "value": "",
                "type": "query"
              },
              {
                "name": "season",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get football league standings"
        }
      ]
    }
  ],
  "bundled": true
}