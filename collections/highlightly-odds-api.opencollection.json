{
  "opencollection": "1.0.0",
  "info": {
    "name": "Highlightly Sports Catalog Odds API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-rapidapi-key",
      "value": "{{x-rapidapi-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Odds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List bookmakers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sports.highlightly.net/football/bookmakers",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List bookmakers"
        },
        {
          "info": {
            "name": "Get a bookmaker by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sports.highlightly.net/football/bookmakers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a bookmaker by ID"
        },
        {
          "info": {
            "name": "List football odds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sports.highlightly.net/football/odds",
            "params": [
              {
                "name": "oddsType",
                "value": "",
                "type": "query"
              },
              {
                "name": "leagueId",
                "value": "",
                "type": "query"
              },
              {
                "name": "leagueName",
                "value": "",
                "type": "query"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query"
              },
              {
                "name": "bookmakerId",
                "value": "",
                "type": "query"
              },
              {
                "name": "bookmakerName",
                "value": "",
                "type": "query"
              },
              {
                "name": "matchId",
                "value": "",
                "type": "query"
              },
              {
                "name": "date",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List football odds"
        }
      ]
    }
  ],
  "bundled": true
}